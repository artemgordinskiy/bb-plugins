{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "artemgordinskiy",
  "displayName": "Artem's plugins",
  "description": "bb plugins for self-hosted bb servers.",
  "plugins": [
    {
      "id": "server-switcher",
      "displayName": "Server Switcher",
      "description": "Lists your self-hosted bb servers in the sidebar footer and switches between them, without a bb account.",
      "icon": "ComputerCloud",
      "tags": ["servers", "self-hosted"],
      "author": { "name": "Artem Gordinskiy", "github": "artemgordinskiy" },
      "source": {
        "git": {
          "url": "https://github.com/artemgordinskiy/bb-plugins.git",
          "subdir": "plugins/server-switcher",
          "range": "^0.2.0",
          "tagPrefix": "server-switcher/"
        }
      }
    },
    {
      "id": "typography",
      "displayName": "Typography",
      "description": "Fonts and sizes for bb: a book-like reading setup for chat messages, the interface font and size, and one code font for code blocks, diffs and the terminal. Bundled open fonts or any font on your device.",
      "icon": "TextWrap",
      "tags": ["typography", "fonts", "appearance"],
      "author": { "name": "Artem Gordinskiy", "github": "artemgordinskiy" },
      "source": {
        "git": {
          "url": "https://github.com/artemgordinskiy/bb-plugins.git",
          "subdir": "plugins/typography",
          "range": "^0.1.0",
          "tagPrefix": "typography/"
        }
      }
    }
  ]
